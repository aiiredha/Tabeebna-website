---
layout: base.njk
pagination:
  data: roles
  size: 1
  alias: role
permalink: "/apply/{{ role.slug }}/"
eleventyComputed:
  title: "{{ role.title }} Application"
  description: "Apply for the {{ role.title }} role at Tabeebna."
---
<section class="section" style="padding-top:48px">
  <div class="wrap" style="max-width:680px">
    <p class="eyebrow"><a href="{{ '/apply/' | url }}">&larr; All roles</a></p>
    <h1>{{ role.title }} Application</h1>
    <p class="lede">Fill this out and hit submit — it'll open your email app with everything pre-filled to send straight to us.</p>

    <form id="application-form" class="apply-form" data-role="{{ role.title }}" style="margin-top:32px">
      <label class="form-field">
        <span>Full Name</span>
        <input type="text" name="Full Name" required>
      </label>

      <label class="form-field">
        <span>School / Grade</span>
        <input type="text" name="School / Grade" required>
      </label>

      <label class="form-field">
        <span>Phone Number</span>
        <input type="tel" name="Phone Number" required>
      </label>

      <label class="form-field">
        <span>Email Address</span>
        <input type="email" name="Email Address" required>
      </label>

      <label class="form-field">
        <span>Why do you want to join Tabeebna, and specifically this role?</span>
        <textarea name="Why this role" rows="4" required></textarea>
      </label>

      <label class="form-field">
        <span>What extracurricular activities are you planning to take part in this academic year?</span>
        <textarea name="Extracurriculars" rows="3" required></textarea>
      </label>

      {% if role.hasPortfolio %}
      <label class="form-field">
        <span>Share examples of your past creative work. (Graphic design posters, photos, videos)</span>
        <input type="text" name="Portfolio" placeholder="Paste a link (Google Drive, Instagram, etc.)" required>
      </label>
      {% endif %}

      <label class="form-field">
        <span>Anything else you'd like us to know? <em>(optional)</em></span>
        <textarea name="Anything else" rows="3"></textarea>
      </label>

      <button type="submit" class="btn btn-primary" style="margin-top:8px">Submit application</button>
      <p class="form-note">This opens your email app with your answers pre-filled — just hit send from there.</p>
    </form>
  </div>
</section>

<script>
  document.getElementById('application-form').addEventListener('submit', function (e) {
    e.preventDefault();
    const form = e.target;
    const roleTitle = form.dataset.role;
    const lines = [];
    form.querySelectorAll('input, textarea').forEach(function (field) {
      const value = field.value.trim();
      if (value) {
        lines.push(field.name + ':\n' + value);
      }
    });
    const subject = encodeURIComponent('Tabeebna Application - ' + roleTitle);
    const body = encodeURIComponent(lines.join('\n\n'));
    window.location.href = 'mailto:tabeebnabh@gmail.com?subject=' + subject + '&body=' + body;
  });
</script>
